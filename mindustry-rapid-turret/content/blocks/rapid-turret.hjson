type: ItemTurret
name: Rapid Turret
description: Fires a stream of bullets at an extremely high rate. Great against swarms.
category: turret
requirements: [
  copper/80
  graphite/60
  silicon/40
]
size: 2
health: 900
range: 200
reload: 2
inaccuracy: 5
rotateSpeed: 15
recoil: 0.5
shootY: 4
maxAmmo: 60
ammoPerShot: 1
targetAir: true
targetGround: true
coolant: {
  type: ConsumeLiquid
  liquid: water
  amount: 0.2
}
coolantMultiplier: 4
shoot: {
  type: ShootAlternate
  spread: 4
}
ammo: {
  copper: {
    type: BasicBulletType
    damage: 9
    speed: 3.2
    lifetime: 65
    width: 6
    height: 9
    ammoMultiplier: 3
  }
  graphite: {
    type: BasicBulletType
    damage: 18
    speed: 3.5
    lifetime: 60
    width: 7
    height: 11
    reloadMultiplier: 0.8
    ammoMultiplier: 4
  }
  silicon: {
    type: BasicBulletType
    damage: 12
    speed: 3.5
    lifetime: 60
    width: 6
    height: 10
    homingPower: 0.08
    homingRange: 60
    reloadMultiplier: 1.3
    ammoMultiplier: 5
  }
}
