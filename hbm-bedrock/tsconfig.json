{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "lib": [
      "ES2022"
    ],
    "types": []
  },
  "include": [
    "behavior_pack/scripts",
    "clearlag_pack/scripts"
  ]
}
